    "/v1/auditability/audit-packs": {
      "post": {
        "tags": [
          "auditability"
        ],
        "summary": "Create Audit Pack",
        "description": "Enqueues generation and returns immediately -- the record itself, at\nstatus=generating, IS the queue entry. `AuditPackWorker` (started in main.py's\nlifespan) picks it up via a durable Postgres SELECT FOR UPDATE SKIP LOCKED poll\nloop, the same design Module 17 already proved for its own evidence packs.",
        "operationId": "create_audit_pack_v1_auditability_audit_packs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuditPackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPackSchema"
