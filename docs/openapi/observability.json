  "components": {
    "schemas": {
      "CostAttributionEntrySchema": {
        "properties": {
          "span_id": {
            "type": "string",
            "title": "Span Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          }
        },
        "type": "object",
        "required": [
          "span_id",
          "name",
          "duration_seconds",
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "title": "CostAttributionEntrySchema"
      },
      "CostAttributionResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/CostAttributionEntrySchema"
            },
            "type": "array",
            "title": "Entries"
          },
          "total_cost_usd": {
            "type": "number",
            "title": "Total Cost Usd"
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "entries",
          "total_cost_usd"
        ],
        "title": "CostAttributionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "workflow_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workflow Type"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/SpanInput"
            },
            "type": "array",
            "title": "Spans"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "trace_id",
          "spans"
        ],
        "title": "IngestRequest"
      },
      "IngestResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "spans_ingested": {
            "type": "integer",
            "title": "Spans Ingested"
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "spans_ingested"
        ],
        "title": "IngestResponse"
      },
      "ReasoningNarrativeResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "narrative": {
            "type": "string",
