          },
          "traces_checked": {
            "type": "integer",
            "title": "Traces Checked"
          },
          "traces_with_known_shape": {
            "type": "integer",
            "title": "Traces With Known Shape"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "completeness_ratio",
          "traces_checked",
          "traces_with_known_shape"
        ],
