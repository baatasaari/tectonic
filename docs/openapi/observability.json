        },
        "type": "object",
        "required": [
          "trace_id",
          "narrative",
          "span_count"
        ],
        "title": "ReasoningNarrativeResponse"
      },
      "SpanInput": {
        "properties": {
          "span_id": {
            "type": "string",
            "title": "Span Id"
          },
          "parent_span_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Span Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "service_name": {
            "type": "string",
            "title": "Service Name",
            "default": "unknown"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "title": "End Time"
          },
          "attributes": {
            "additionalProperties": true,
            "type": "object",
            "title": "Attributes",
            "default": {}
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "required": [
          "span_id",
          "name",
          "start_time",
          "end_time"
        ],
        "title": "SpanInput"
