{
  "openapi": "3.1.0",
  "info": {
    "title": "Context Engineering",
    "description": "Tectonic Agentic AI Platform \u2014 Module 7: assembles, compresses and prunes context within token budget using ontology constraints.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/context-engineering/assemble": {
      "post": {
        "tags": [
          "context-engineering"
        ],
        "summary": "Assemble",
        "operationId": "assemble_v1_context_engineering_assemble_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssembleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssembleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/context-engineering/ontologies": {
      "post": {
        "tags": [
          "context-engineering"
        ],
        "summary": "Create Ontology",
        "operationId": "create_ontology_v1_context_engineering_ontologies_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOntologyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OntologySummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/context-engineering/weights/{task_type}": {
      "get": {
        "tags": [
          "context-engineering"
        ],
        "summary": "Get Weights",
        "operationId": "get_weights_v1_context_engineering_weights__task_type__get",
        "parameters": [
          {
            "name": "task_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeightsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": []
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "AssembleRequest": {
        "properties": {
          "candidate_items": {
            "items": {
              "$ref": "#/components/schemas/CandidateItemSchema"
            },
            "type": "array",
            "title": "Candidate Items"
          },
          "token_budget": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Budget"
          },
          "task_type": {
            "type": "string",
            "title": "Task Type",
            "default": "default"
          },
          "request_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Ref"
          }
        },
        "type": "object",
        "required": [
          "candidate_items"
        ],
        "title": "AssembleRequest"
      },
      "AssembleResponse": {
        "properties": {
          "assembled_context": {
            "type": "string",
            "title": "Assembled Context"
          },
          "tokens_used": {
            "type": "integer",
            "title": "Tokens Used"
          },
          "items_dropped_count": {
            "type": "integer",
            "title": "Items Dropped Count"
          },
          "items_included_count": {
            "type": "integer",
            "title": "Items Included Count"
          },
          "items_summarised_count": {
            "type": "integer",
            "title": "Items Summarised Count"
          }
        },
        "type": "object",
        "required": [
          "assembled_context",
          "tokens_used",
          "items_dropped_count",
          "items_included_count",
          "items_summarised_count"
        ],
        "title": "AssembleResponse"
      },
      "CandidateItemSchema": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "source",
          "content"
        ],
        "title": "CandidateItemSchema"
      },
      "CreateOntologyRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles",
            "default": []
          },
          "entity_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Entity Types",
            "default": []
          },
          "policy_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Policy Tags",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "tenant_id"
        ],
        "title": "CreateOntologyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OntologySummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "title": "OntologySummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WeightsResponse": {
        "properties": {
          "task_type": {
            "type": "string",
            "title": "Task Type"
          },
          "feature_weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Feature Weights"
          }
        },
        "type": "object",
        "required": [
          "task_type",
          "feature_weights"
        ],
        "title": "WeightsResponse"
      }
    },
    "securitySchemes": {
      "ServiceBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Service-to-service HS256 JWT bearer auth (security/jwt_auth.py): every inbound request must carry `Authorization: Bearer <token>`, verified against this module's own service_name as the required audience (TECTONIC_JWT_SHARED_SECRET, one shared signing key across every module in this deployment). Not a user-facing OAuth/OIDC flow -- see this module's README for the full design note."
      }
    }
  },
  "security": [
    {
      "ServiceBearerAuth": []
    }
  ]
}