    "/v1/regulatory-compliance/control-events": {
      "post": {
        "tags": [
          "regulatory-compliance"
        ],
        "summary": "Record Control Event",
        "description": "Direct ingestion of a control-implementation event. The LLD's own diagram has these\nevents arrive via Auditability (Human Oversight/Guardrails/Workflow Engine publish to\nAuditability, which forwards here) \u2014 since Auditability (Module 20) isn't built yet in\nthis platform, source modules post here directly. Wiring a real Auditability-event\nconsumer becomes a drop-in replacement for this endpoint once Module 20 exists.",
        "operationId": "record_control_event_v1_regulatory_compliance_control_events_post",
        "requestBody": {
          "content": {
