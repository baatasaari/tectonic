    "/v1/regulatory-compliance/evidence-packs": {
      "post": {
        "tags": [
          "regulatory-compliance"
        ],
        "summary": "Create Evidence Pack",
        "description": "Enqueues generation and returns immediately \u2014 the record itself, at\nstatus=generating, IS the queue entry. `EvidencePackWorker` (started in main.py's\nlifespan) picks it up via a durable Postgres SELECT FOR UPDATE SKIP LOCKED poll\nloop, not an in-process FastAPI BackgroundTasks job, so a pod restart between this\n202 response and the job completing no longer loses the work: the pack stays\nclaimable by any worker instance until it actually finishes.",
        "operationId": "create_evidence_pack_v1_regulatory_compliance_evidence_packs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEvidencePackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePackSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
