  "components": {
    "schemas": {
      "BypassIncidentSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "attack_pattern": {
            "type": "string",
            "title": "Attack Pattern"
          },
          "target_check": {
            "type": "string",
            "title": "Target Check"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "resolved": {
            "type": "boolean",
            "title": "Resolved"
          }
        },
        "type": "object",
        "required": [
          "id",
          "attack_pattern",
          "target_check",
          "severity",
          "resolved"
        ],
        "title": "BypassIncidentSchema"
      },
      "CheckRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "policy_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Profile Id"
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "text",
          "stage"
        ],
        "title": "CheckRequest"
      },
      "CheckResponse": {
        "properties": {
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "violation_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Violation Category"
          },
          "redacted_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redacted Text"
          },
          "checks_run": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks Run"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "violation_category",
          "redacted_text",
          "checks_run"
        ],
        "title": "CheckResponse"
      },
      "CreatePolicyProfileRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": "default"
          },
          "enabled_checks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enabled Checks",
            "default": [
              "pii_detection",
              "jailbreak_detection",
              "groundedness_check"
            ]
          },
          "entity_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Entity Types",
            "default": [
              "EMAIL",
              "PHONE_NUMBER",
              "PERSON",
              "CREDIT_CARD"
            ]
          },
          "denied_topics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Denied Topics",
            "default": []
          },
          "groundedness_threshold": {
            "type": "number",
            "title": "Groundedness Threshold",
            "default": 0.85
          }
        },
        "type": "object",
        "required": [
          "tenant_id"
        ],
        "title": "CreatePolicyProfileRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PolicyProfileSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "enabled_checks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enabled Checks"
          },
          "pii_entity_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pii Entity Types"
          },
          "denied_topics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Denied Topics"
          },
          "groundedness_threshold": {
            "type": "number",
            "title": "Groundedness Threshold"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "name",
          "enabled_checks",
          "pii_entity_types",
          "denied_topics",
          "groundedness_threshold",
          "status",
          "created_at"
        ],
        "title": "PolicyProfileSchema"
      },
      "RedTeamRunListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RedTeamRunSchema"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "RedTeamRunListResponse"
      },
      "RedTeamRunSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "attempts_generated": {
            "type": "integer",
            "title": "Attempts Generated"
          },
          "successful_bypasses": {
            "type": "integer",
            "title": "Successful Bypasses"
          },
          "run_at": {
            "type": "string",
            "format": "date-time",
            "title": "Run At"
          },
          "bypass_incidents": {
            "items": {
              "$ref": "#/components/schemas/BypassIncidentSchema"
            },
            "type": "array",
            "title": "Bypass Incidents",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "attempts_generated",
          "successful_bypasses",
          "run_at"
        ],
        "title": "RedTeamRunSchema"
      },
      "TriggerRedTeamRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
